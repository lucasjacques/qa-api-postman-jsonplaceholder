  "item": [
    {
      "name": "GET - Retrieve Post by ID - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response should have Content-Type header\", function () {\r",
              "    pm.expect(pm.response.headers.has(\"Content-Type\")).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type should be application/json\", function () {\r",
              "    const contentType = pm.response.headers.get(\"Content-Type\");\r",
              "    pm.expect(contentType).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response has required fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "    pm.expect(jsonData).to.have.property(\"userId\");\r",
              "    pm.expect(jsonData).to.have.property(\"title\");\r",
              "    pm.expect(jsonData).to.have.property(\"body\");\r",
              "});\r",
              "\r",
              "pm.test(\"ID is valid\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.eql(1);\r",
              "}); "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      },
